		"./hypermedia-action-state-refs": {
			"types": "./dist/hypermedia-action-state-refs.d.mts",
			"default": "./dist/hypermedia-action-state-refs.mjs"
		},
		"./hypermedia-build-imports": {
			"types": "./dist/hypermedia-build-imports.d.mts",
			"default": "./dist/hypermedia-build-imports.mjs"
		},
		"./tokenizer": {
			"types": "./dist/tokenizer.d.mts",
			"default": "./dist/tokenizer.mjs"
		},
		"./lowerer": {
			"types": "./dist/lowerer/index.d.mts",
			"default": "./dist/lowerer/index.mjs"
		},
		"./lowerer/lowerer": {
			"types": "./dist/lowerer/lowerer.d.mts",
