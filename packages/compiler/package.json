			"types": "./dist/path.d.mts",
			"default": "./dist/path.mjs"
		},
		"./directive-attributes": {
			"types": "./dist/directive-attributes.d.mts",
			"default": "./dist/directive-attributes.mjs"
		},
		"./build-directive-attributes": {
			"types": "./dist/build-directive-attributes.d.mts",
			"default": "./dist/build-directive-attributes.mjs"
		},
		"./author-attribute-format": {
			"types": "./dist/author-attribute-format.d.mts",
			"default": "./dist/author-attribute-format.mjs"
		},
		"./create-event-handler-action-scope": {
			"types": "./dist/create-event-handler-action-scope.d.mts",
