{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"paths": {
			"@aero-js/core/utils/aliases": ["../core/dist/utils/aliases.d.mts"]
		},
		"lib": ["ES2020"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": false,
		"sourceMap": true,
		"types": ["node", "vscode"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "../html-parser/src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "src/server.ts"]
}
